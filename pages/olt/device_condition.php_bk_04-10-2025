<script>
$(document).ready(function() {
    $('#userModal').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget);
        var mac = button.data('mac');
        var username = button.data('username');
        var modal = $(this);
        modal.find('#modalMacAddress').val(mac);
        modal.find('#usernameInput').val(username);
        modal.find('#modal-alert').hide();
    });

    $('#saveUsernameBtn').on('click', function() {
        var mac = $('#modalMacAddress').val();
        var username = $('#usernameInput').val().trim();
        var modalAlert = $('#modal-alert');

        if (username === '') {
            modalAlert.removeClass('alert-success').addClass('alert-danger').text('Username cannot be empty.').show();
            return;
        }

        $.ajax({
            url: 'pages/olt/save_username.php',
            type: 'POST',
            data: { mac: mac, username: username },
            dataType: 'json',
            success: function(response) {
                if (response.success) {
                    var macId = mac.replace(/:/g, '');
                    $('#username-' + macId).text(username);
                    $('button[data-mac="' + mac + '"]').data('username', username);
                    modalAlert.removeClass('alert-danger').addClass('alert-success').text(response.message).show();
                    setTimeout(function() { $('#userModal').modal('hide'); }, 1500);
                } else {
                    modalAlert.removeClass('alert-success').addClass('alert-danger').text(response.message).show();
                }
            },
            error: function() {
                modalAlert.removeClass('alert-success').addClass('alert-danger').text('An error occurred.').show();
            }
        });
    });
});
